      m_Calls: []
  m_text: "ABOUT THE GAME & ZAZA\n\nHi there! Thank you for stepping into this cozy
    little world.\n\nI'm an indie dev from Ukraine, and this project is built with
    lots of love. Almost every furry character you meet here is based on a real-life
    pet I've met along the way!\n\nThe ultimate star of this journey is Zaza \u2014
    my precious little stinkbun and daily inspiration for it all.\n\nEnjoy the game! "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 72d02b21bb2c6bd4fbe334b3cec3538a, type: 2}
  m_sharedMaterial: {fileID: 6847103456552639605, guid: 72d02b21bb2c6bd4fbe334b3cec3538a, type: 2}
